	(text "S1 closed = normal range; open = short range.\nD1 operates at zero bias (photovoltaic mode). Anode to GND is intentional."
		(exclude_from_sim no)
		(at 19.558 109.474 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "6bbe1ff7-f873-4222-89df-a8f1f56ac928")
	)
	(text "Main Sensor"
		(exclude_from_sim no)
		(at 29.21 143.764 0)
		(effects
			(font
				(size 2.032 2.032)
			)
		)
		(uuid "7b000697-79ba-48c1-b3f3-159d0e1c7695")
	)
	(text "Circuit GND floats. Do not connect the jack sleeve to GND. Q1/Q2 form a\nbidirectional solid-state switch and need logic-level gates Vgs(th) well\nunder 2 V on a CR2032)."
		(exclude_from_sim no)
		(at 190.5 142.494 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "a0aa1b39-5375-4fd9-98f4-478c5b860486")
	)
	(text "D3 operates at zero bias (photovoltaic mode). Anode to GND is intentional."
		(exclude_from_sim no)
		(at 19.558 147.32 0)
		(effects

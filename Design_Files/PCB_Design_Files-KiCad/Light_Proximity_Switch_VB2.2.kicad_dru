(version 1)
(rule "class 2:1"
  (condition "A.NetClass == 'GND2' && B.NetClass == 'GND1'")
  (constraint clearance (min 0.205mm)))

(rule "class 2:2"
  (condition "A.NetClass == 'GND2' && B.NetClass == 'GND2'")
  (constraint clearance (min 0.205mm)))

(rule "class 3:1"
  (condition "A.NetClass == 'GND3' && B.NetClass == 'GND1'")
  (constraint clearance (min 0.205mm)))

(rule "class 3:2"
  (condition "A.NetClass == 'GND3' && B.NetClass == 'GND2'")
  (constraint clearance (min 0.205mm)))

(rule "class 3:3"
  (condition "A.NetClass == 'GND3' && B.NetClass == 'GND3'")
  (constraint clearance (min 0.205mm)))
